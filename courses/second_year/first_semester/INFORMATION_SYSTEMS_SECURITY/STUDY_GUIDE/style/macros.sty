% Protocol and Crypto notation macros
\newcommand{\concat}{\parallel}
\newcommand{\xor}{\oplus}
\newcommand{\symenc}[2]{\mathbf{E}_{#1}\left[#2\right]}
\newcommand{\symdec}[2]{\mathbf{D}_{#1}\left[#2\right]}
\newcommand{\asymenc}[2]{\mathbf{Enc}_{#1}\left(#2\right)}
\newcommand{\asymdec}[2]{\mathbf{Dec}_{#1}\left(#2\right)}
\newcommand{\digitalsign}[2]{\mathbf{S}_{#1}\left(#2\right)}
\newcommand{\chash}[1]{\mathbf{H}\left(#1\right)}
\newcommand{\chmac}[2]{\mathbf{HMAC}_{#1}\left(#2\right)}
