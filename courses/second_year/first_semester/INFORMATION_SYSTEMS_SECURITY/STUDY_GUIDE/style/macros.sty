\ProvidesPackage{macros}[2026/09/23 v1.0 Style macros for Sicurezza dei Sistemi Informativi Study Guide]

% Typography and encoding
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[italian]{babel}
\RequirePackage{microtype}

% Math
\RequirePackage{amsmath,amssymb,amsfonts}

% Colors
\RequirePackage{xcolor}
\definecolor{secblue}{RGB}{20, 75, 145}
\definecolor{secgreen}{RGB}{25, 125, 60}
\definecolor{secred}{RGB}{185, 30, 30}
\definecolor{secorange}{RGB}{215, 105, 15}
\definecolor{secgray}{RGB}{95, 105, 115}
\definecolor{secpurple}{RGB}{115, 35, 140}

% Page layout
\RequirePackage{geometry}
\geometry{
    top=2.8cm,
    bottom=2.8cm,
    left=2.5cm,
    right=2.5cm,
    headheight=14pt,
    footskip=1.2cm
}

% Tables and lists
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.8em}

% Icons and currency
\RequirePackage{fontawesome5}
\RequirePackage{eurosym}

% TikZ and graphics
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, shapes.geometric, shapes.symbols, backgrounds, decorations.pathreplacing, matrix, fit}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% Listings / Code blocks
\RequirePackage{listings}
\lstset{
    basicstyle=\ttfamily\small,
    breaklines=true,
    frame=single,
    backgroundcolor=\color{gray!8},
    rulecolor=\color{gray!30},
    keywordstyle=\color{secblue}\bfseries,
    commentstyle=\color{secgreen}\itshape,
    stringstyle=\color{secorange},
    showstringspaces=false,
    tabsize=4
}

% Hyperref
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=secblue,
    citecolor=secgreen,
    urlcolor=secpurple,
    filecolor=secblue,
    pdfstartview={FitH}
}

% Tcolorbox environments
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% 1. Book Dive (Textbook deepening)
\newtcolorbox{bookdive}[1][]{
    enhanced,
    breakable,
    colback=secgreen!5!white,
    colframe=secgreen!85!black,
    coltitle=white,
    fonttitle=\bfseries\small,
    title={\faBookOpen\ \ Approfondimento da Testo: #1},
    attach boxed title to top left={yshift*=-\tcboxedtitleheight/2, xshift=4mm},
    boxed title style={colback=secgreen!85!black, boxrule=0pt, arc=3pt},
    top=3.5mm, bottom=3mm, left=3.5mm, right=3.5mm, boxrule=1pt, arc=4pt,
    before skip=4mm, after skip=4mm
}

