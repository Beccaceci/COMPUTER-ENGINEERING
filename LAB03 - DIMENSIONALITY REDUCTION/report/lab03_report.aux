\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Histograms of the data projected onto the first two PCA directions. Notice the heavy overlap between the Fake and Genuine classes despite the high overall variance.}}{1}{}\protected@file@percent }
\newlabel{fig:pca_hist_1_2}{{1}{1}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scatter plot of the first two PCA directions. The geometric clusters of the original dataset are merely rotated; the classes remain heavily intertwined.}}{2}{}\protected@file@percent }
\newlabel{fig:pca_scatter_1_2}{{2}{2}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces LDA Projection (1D). Unlike PCA, the supervised LDA projection clearly separates the density centers of the Fake and Genuine classes.}}{2}{}\protected@file@percent }
\newlabel{fig:lda_histogram}{{3}{2}{}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}LDA analysis}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Histogram of the data projected onto the LDA direction. The density centers are separated, but the tails overlap.}}{3}{}\protected@file@percent }
\newlabel{fig:lda_hist_overlap}{{4}{3}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Validation error rate as a function of the classification threshold. The green dashed line indicates the empirical optimum, which achieves a slightly lower error rate (9.1\%) than the default geometric mean threshold (9.3\%, red dashed line).}}{4}{}\protected@file@percent }
\newlabel{fig:lda_threshold_sweep}{{5}{4}{}{figure.5}{}}
