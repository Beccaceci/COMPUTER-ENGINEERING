\@writefile{toc}{\contentsline {section}{\numberline {1}Gaussian Density Estimation}{2}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Examples of good Gaussian fits: Fake Feature 1 (left) and Genuine Feature 3 (right). Both exhibit a relatively symmetric, bell-shaped empirical distribution.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:good_gaussian_fits}{{1}{2}{Examples of good Gaussian fits: Fake Feature 1 (left) and Genuine Feature 3 (right). Both exhibit a relatively symmetric, bell-shaped empirical distribution}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Examples of inaccurate Gaussian fits: Fake Feature 5 (left) and Genuine Feature 5 (right). The rigid symmetry of the Gaussian model completely misses the sharp peaks and asymmetric tails.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:bad_gaussian_fits}{{2}{3}{Examples of inaccurate Gaussian fits: Fake Feature 5 (left) and Genuine Feature 5 (right). The rigid symmetry of the Gaussian model completely misses the sharp peaks and asymmetric tails}{figure.2}{}}
